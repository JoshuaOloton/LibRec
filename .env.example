# Postgres (percent-encode special characters in the password, e.g. @ -> %40)
# Local development: the database from docker-compose.yml (npm run db:up)
DATABASE_URL="postgresql://librec:librec@localhost:5443/librec"
# Deployment: a hosted database such as Neon, for example
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
AUTH_SECRET="generate with: openssl rand -base64 32"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
# Optional, used by scripts/data description fetcher
GOOGLE_BOOKS_API_KEY=""
# Optional. Vitest and Playwright use the local docker database by default, in their own schemas
# (librec_test, librec_test_e2e), and never DATABASE_URL. Override only to test against another database;
# the schema name must contain "test".
# TEST_DATABASE_URL="postgresql://librec:librec@localhost:5443/librec?schema=librec_test"
# E2E_DATABASE_URL="postgresql://librec:librec@localhost:5443/librec?schema=librec_test_e2e"
